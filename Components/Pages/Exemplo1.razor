@page "/Exemplo1"
@rendermode InteractiveServer

<PageTitle>Exemplo-01</PageTitle>
<h1>@Titulo</h1>
<p>Está é a página de exemplo 1.</p>

<form>
    <div class="row">

        <div class="col-md-4">
            <label for="nomeInput" class="form-label">Nome:</label>
            <input type="text" @bind-value="xNome" class="form-control" id="nomeInput" placeholder="Digite seu nome" />
        </div>

        <div class="col-md-4">
            <label for="endeInput" class="form-label">Endereço:</label>
            <input type="text" class="form-control" id="endeInput" placeholder="Digite seu endereço" />
        </div>

        <div class="col-md-4">
            <label for="emailInput" class="form-label">Email:</label>
            <input type="text" class="form-control" id="emailInput" placeholder="Digite seu Email" />
        </div>
    </div>

    <div class="row">

        <div class="col-md-4">
            <label for="TelefoneInput" class="form-label">Telefone:</label>
            <input type="text" class="form-control" id="TelefoneInput" placeholder="Digite seu Telefone" />
        </div>
        <div class="col-md-4">
            <label for="CidadeInput" class="form-label">Cidade:</label>
            <input type="text" class="form-control" id="CidadeInput" placeholder="Digite sua Cidade" />
        </div>
        <div class="col-md-4">
            <label for="CEPInput" class="form-label">CEP:</label>
            <input type="text" @bind-value='xCep' class="form-control" id="CEPInput" placeholder="Digite seu CEP" />
        </div>

    </div>

    <div class="row">

        <div class="col-md-2">
            <button type="button" @onclick="Enviar" class="btn btn-success">Enviar</button>

        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-danger">Limpar</button>

        </div>
    </div>

</form>

<style>
    .form-control {
        margin-bottom: 15px;
        border: 2px solid blue;
    }
</style>

@code {

    private string Titulo = "Formulario de Cadastro";
    private string xNome;
    private string xCep;
    private void Enviar()
    {
        if (string.IsNullOrEmpty(xNome))
        {
            Titulo = "Por favor, preencha o campo Nome.";
            return;
        }
        if (string.IsNullOrEmpty(xCep))
        {
            Titulo = "Por favor, preencha o campo CEP.";
            return;
        }

        Titulo = "Formulario Enviado com Sucesso!";
        //StateHasChanged();
    }

}