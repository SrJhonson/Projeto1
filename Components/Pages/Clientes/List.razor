@page "/clientes"
@rendermode InteractiveServer
@using Projeto1.interfaces
@inject IClienteRepository _clientRepository

<h3>Listagem de Clientes</h3>
<a href="/clientes/add" class="btn btn-primary">Adicionar</a>



@if (listaClientes == null || listaClientes.Count == 0)
{
    <p>Carregando Clientes...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Email</th>
                <th>Telefone</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in listaClientes)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nome</td>
                    <td>@item.Email</td>
                    <td>@item.Telefone</td>
                    <td>
                        <a href="/clientes/edit" class="btn btn-sm btn-warning">Editar</a>
                    </td>
                    <td>
                        <a href="/clientes/delete" class="btn btn-sm btn-danger">Deletar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    private List<Cliente> listaClientes = new();

    protected override async Task OnInitializedAsync()
    {
        listaClientes = await _clientRepository.ListarTodosAsync();
    }


}